    {
      "version": "feo009-0.1.0",
      "description": "Do not treat document or sentence co-presence as an event-value relation. An explicit request becomes a review candidate only.",
      "target_class": "",
      "target_property": "https://w3id.org/fneo/hasReportedValue",
      "population_profile": "CANDIDATE_REVIEW",
      "assertion_profile": "EXTENSION_REVIEWED",
      "decision_profile_mode": "rule",
      "consumes_profiles": [
        "CORE_DETERMINISTIC",
