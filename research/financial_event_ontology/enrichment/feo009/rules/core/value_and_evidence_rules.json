      "rejection_conditions": [],
      "scope_conditions": [],
      "outcome_overrides": [
        {
          "when": "event_value_explicitly_requested",
          "status": "requires_review"
        },
        {
          "when": "co_presence_only_event_value",
          "status": "rejected"
        }
      ],
      "confidence_contributions": {
        "document_present": "0.10"
      },
      "negative_penalties": {},
      "acceptance_threshold": "1.00",
      "review_threshold": "0.40",
      "evidence_requirements": [
        "textual_evidence_present",
        "document_present"
      ],
      "materialisation_policy": "direct_and_qualified",
      "applicable_shacl_shapes": [],
      "assertion_kind": "relation",
      "examples": [
        "A percentage in the same sentence as an event is not hasReportedValue."
