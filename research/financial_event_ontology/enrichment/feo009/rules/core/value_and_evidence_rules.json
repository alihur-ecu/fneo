{
  "rules": [
    {
      "version": "feo009-0.1.0",
      "description": "Type a percentage in percentage points and preserve the lexical form. Do not convert 5.25% to 0.0525.",
      "target_class": "https://w3id.org/fneo/PercentageValue",
      "target_property": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
      "population_profile": "CORE_DETERMINISTIC",
      "assertion_profile": "CORE_DETERMINISTIC",
      "decision_profile_mode": "rule",
      "consumes_profiles": [
        "CORE_DETERMINISTIC"
      ],
      "candidate_kinds": [
        "value_candidate"
      ],
      "phase": "value_type",
      "exclusive_group": "value_type",
      "priority": 80,
      "applicability_conditions": [
        "applies_percentage"
      ],
      "required_conditions": [
        "percentage_lexical_preserved",
        "percentage_points_not_fraction",
        "value_type_numeric",
        "value_lexical_present",
        "document_present",
        "valid_evidence_span"
      ],
      "optional_conditions": [],
      "negative_conditions": [
        "negative_percentage_as_fraction",
        "invalid_percentage_fraction",
        "negative_co_presence_attachment",
        "invalid_offset",
        "negative_factuality_as_requirement"
      ],
      "blocking_conditions": [
        "negative_percentage_as_fraction",
        "invalid_percentage_fraction"
      ],
      "review_conditions": [],
      "rejection_conditions": [
        "negative_percentage_as_fraction",
        "invalid_percentage_fraction",
        "invalid_offset",
        "missing_document"
      ],
      "scope_conditions": [],
      "outcome_overrides": [],
      "confidence_contributions": {
        "percentage_lexical_preserved": "0.35",
        "percentage_points_not_fraction": "0.35",
        "value_lexical_present": "0.15",
        "document_present": "0.15"
      },
      "negative_penalties": {},
      "acceptance_threshold": "0.80",
      "review_threshold": "0.40",
      "evidence_requirements": [
        "textual_evidence_present",
        "document_present"
      ],
      "materialisation_policy": "direct_and_qualified",
      "applicable_shacl_shapes": [
        "PercentageValueShape",
        "NumericalValueShape"
      ],
      "assertion_kind": "relation",
      "examples": [
        "5.25% is stored as 5.25, not 0.0525."
      ],
      "known_limitations": [
        "Value typing does not attach the value to an event."
      ],
      "omit_assertion_unless_accepted": false,
      "rule_id": "VAL-PERCENT-001"
    },
