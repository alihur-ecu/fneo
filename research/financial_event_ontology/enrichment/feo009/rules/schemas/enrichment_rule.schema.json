{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/fneo/schema/enrichment-rule",
  "title": "Enrichment rule",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "rule_id",
    "version",
    "description",
    "population_profile",
    "required_conditions",
    "optional_conditions",
    "negative_conditions",
    "blocking_conditions",
    "confidence_contributions",
    "acceptance_threshold",
    "review_threshold",
    "rejection_conditions",
    "evidence_requirements",
    "materialisation_policy",
    "applicable_shacl_shapes",
    "examples",
    "known_limitations"
  ],
  "properties": {
    "rule_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 10},
    "target_class": {"type": "string"},
    "target_property": {"type": "string"},
    "population_profile": {
      "type": "string",
      "enum": [
        "CORE_DETERMINISTIC",
        "EXTENSION_REVIEWED",
        "CANDIDATE_REVIEW",
        "EXPERIMENTAL_TEMPORAL"
      ]
    },
    "required_conditions": {"type": "array", "items": {"type": "string"}},
    "optional_conditions": {"type": "array", "items": {"type": "string"}},
    "negative_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "blocking_conditions": {"type": "array", "items": {"type": "string"}},
    "confidence_contributions": {"type": "object"},
    "acceptance_threshold": {"type": "string"},
    "review_threshold": {"type": "string"},
    "rejection_conditions": {"type": "array", "items": {"type": "string"}},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}},
    "materialisation_policy": {
      "type": "string",
      "enum": ["direct_and_qualified", "structural_direct", "none"]
    },
    "applicable_shacl_shapes": {"type": "array", "items": {"type": "string"}},
    "examples": {"type": "array", "items": {"type": "string"}},
    "known_limitations": {"type": "array", "items": {"type": "string"}}
  }
}
