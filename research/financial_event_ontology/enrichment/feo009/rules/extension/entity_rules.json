{
  "rules": [
    {
      "version": "feo009-0.1.0",
      "description": "Classify a central bank from a controlled name or an accepted reviewer decision with organisation context. A generic organisation code is not sufficient.",
      "target_class": "https://w3id.org/fneo/CentralBank",
      "target_property": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
      "population_profile": "EXTENSION_REVIEWED",
      "assertion_profile": "EXTENSION_REVIEWED",
      "decision_profile_mode": "rule",
      "consumes_profiles": [
        "EXTENSION_REVIEWED"
      ],
      "candidate_kinds": [
        "entity_candidate"
      ],
      "phase": "entity_type",
      "exclusive_group": "entity_type",
      "priority": 80,
      "applicability_conditions": [
        "applies_central_bank"
      ],
      "required_conditions": [
        "controlled_name_or_reviewer_decision",
        "organisation_context",
        "textual_evidence_present",
        "document_present",
        "valid_evidence_span"
      ],
      "optional_conditions": [
        "reviewer_accepted_decision"
      ],
      "negative_conditions": [
        "negative_org_code_only",
        "negative_funding_verb_types_bank",
        "negative_acting_central_bank_role",
        "negative_collective_as_extra_institution",
        "collective_mention",
        "generic_org_without_context",
        "invalid_offset",
        "negative_factuality_as_requirement"
      ],
      "blocking_conditions": [
        "negative_org_code_only",
        "negative_funding_verb_types_bank",
        "collective_mention",
        "invalid_offset"
      ],
      "review_conditions": [
        "collective_mention",
        "negative_acting_central_bank_role"
      ],
      "rejection_conditions": [
        "negative_org_code_only",
        "negative_funding_verb_types_bank",
        "invalid_offset",
        "missing_document"
      ],
      "scope_conditions": [],
      "outcome_overrides": [],
      "confidence_contributions": {
        "controlled_name_or_reviewer_decision": "0.45",
        "organisation_context": "0.25",
        "textual_evidence_present": "0.15",
        "document_present": "0.10"
      },
      "negative_penalties": {},
      "acceptance_threshold": "0.80",
      "review_threshold": "0.40",
      "evidence_requirements": [
        "textual_evidence_present",
        "document_present"
      ],
      "materialisation_policy": "direct_and_qualified",
      "applicable_shacl_shapes": [
        "CentralBankShape"
      ],
      "assertion_kind": "relation",
      "examples": [
        "The US Federal Reserve",
        "the world's central banks"
      ],
      "known_limitations": [
        "Collective central-bank mentions stay in review and are not counted as extra institutions."
      ],
      "omit_assertion_unless_accepted": false,
      "rule_id": "FE-CB-001"
    },
