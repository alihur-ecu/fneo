{
  "rules": [
    {
      "version": "feo009-0.1.0",
      "description": "Accept an explicit event-time anchor. Event order is not event time, and no event time is preferable to an unsupported one.",
      "target_class": "",
      "target_property": "https://w3id.org/fneo/hasEventTime",
      "population_profile": "CORE_DETERMINISTIC",
      "assertion_profile": "CORE_DETERMINISTIC",
      "decision_profile_mode": "rule",
      "consumes_profiles": [
        "CORE_DETERMINISTIC"
      ],
      "candidate_kinds": [
        "temporal_candidate"
      ],
      "phase": "event_time",
      "exclusive_group": "event_time",
      "priority": 60,
      "applicability_conditions": [
        "applies_event_time"
      ],
      "required_conditions": [
        "explicit_event_time_relation",
        "active_committed_nonsuppressed",
        "explicit_inference",
        "traceable_temporal_evidence",
        "document_present"
      ],
      "optional_conditions": [],
      "negative_conditions": [
        "negative_event_ordering_as_event_time",
        "publication_time_is_not_event_time",
        "temporal_status_suppressed",
        "temporal_status_proposed",
        "negative_reasoner_entailment_as_evidence",
        "negative_wrong_temporal_endpoint",
        "negative_factuality_as_requirement"
      ],
      "blocking_conditions": [
        "negative_event_ordering_as_event_time",
        "publication_time_is_not_event_time",
        "temporal_status_suppressed",
        "temporal_status_proposed",
        "negative_wrong_temporal_endpoint"
      ],
      "review_conditions": [],
      "rejection_conditions": [
        "negative_event_ordering_as_event_time",
        "publication_time_is_not_event_time",
        "negative_wrong_temporal_endpoint"
      ],
      "scope_conditions": [],
      "outcome_overrides": [],
      "confidence_contributions": {
        "explicit_event_time_relation": "0.30",
        "active_committed_nonsuppressed": "0.25",
        "explicit_inference": "0.15",
        "traceable_temporal_evidence": "0.20"
      },
      "negative_penalties": {},
      "acceptance_threshold": "0.80",
      "review_threshold": "0.40",
      "evidence_requirements": [
        "textual_evidence_present",
        "document_present"
      ],
      "materialisation_policy": "direct_and_qualified",
      "applicable_shacl_shapes": [
        "RelationAssertionShape",
        "TimeEntityShape"
      ],
      "assertion_kind": "relation",
      "examples": [
        "An event anchored by an explicit HAS_TIME_ANCHOR link to Tuesday."
      ],
      "known_limitations": [
        "Publication time is not used as a fallback event time."
      ],
      "omit_assertion_unless_accepted": false,
      "rule_id": "TMP-ANCHOR-001"
    },
    {
