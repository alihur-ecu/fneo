      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assertion object literal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#Literal"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The literal object of a qualified statement when that object is a literal rather than an individual."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A qualified literal statement whose object is a string."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Do not use both assertionObject and assertionObjectLiteral for one assertion. Ordinary unqualified literals, such as labels, do not need this property."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/abstractExtensionPoint",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "abstract extension point"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Marks a class that is retained as an abstract extension point and is not a population target in this version."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "Financial situation is an abstract extension point."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The value true does not mean the class is deprecated and does not add a subclass axiom."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/priorVersionNote",
