      {
        "@language": "en",
        "@value": "example"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A short example of how a term is used."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A fictional index name used as a market index."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Examples in the ontology are illustrative. Synthetic graphs under the example stem are the machine-readable illustrations."
      }
