      {
        "@language": "en",
        "@value": "competency-question catalogue"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A pointer to the approved competency-question catalogue used to justify this version."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "competency_questions/catalogue/cq_to_ontology_requirements.csv"
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The pointer is a release-relative path, not a public URL and not a claim that the catalogue has been populated."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/suppressionReason",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
