      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The index that participates in a qualified market-change participation."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
