      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/FinancialEntity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "financial entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/Entity"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "An entity that the ontology types as financial, including markets, financial organisations, financial objects, financial systems, and financial sectors."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A fictional equity market after classification."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Not every entity is a financial entity. The class does not copy a source organisation code or a source financial code."
      }
    ]
  },
