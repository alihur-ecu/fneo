    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The exclusive character index after a mention."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "When both character offsets are present for a non-empty span, characterEnd is greater than characterStart."
      }
    ]
  },
  {
    "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb49",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/fneo/TextualMention"
          },
          {
            "@id": "https://w3id.org/fneo/TextualEvidence"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/Currency",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "currency"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/FinancialObject"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/fneo/MonetaryAmount"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A named currency, distinct from a monetary amount and from a market index."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A fictional currency name such as the Northwind dollar."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Extension class under financial object. Disjoint with monetary amount in this version. A currency code on an amount is not this class."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/temporalRelationType",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/TemporalRelationAssertion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "temporal relation type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/fneo/TemporalRelationType"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Relates a temporal relation assertion to a controlled temporal relation type."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "Before on an assertion that also uses precedes when accepted."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The type individual is not the direct property. Before pairs with precedes, After with follows, Simultaneous with simultaneousWith, During with occursDuring, and IncludesRelation with includes."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/backwardCompatibility",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "backward compatibility"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A statement of compatibility with earlier public versions."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "Release candidate 0.1.0-rc2 follows development candidate 0.1.0-rc1."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "No stable public release precedes version 0.1.0. A development candidate may still name a prior version IRI."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/InverseGenerated",
    "@type": [
      "https://w3id.org/fneo/InferenceStatus",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "inverse generated"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The inference status for a relation generated as an inverse of another relation."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "An inverse-generated follows candidate that remains suppressed."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Inverse-generated candidates do not become accepted direct triples merely because an inverse axiom exists in the ontology."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/confidence",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "confidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A confidence value recorded for an automatically proposed assertion or other provenance-bearing statement."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "0.95 on an accepted qualified participation."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Scales are not comparable across components. A missing confidence is unknown, not zero. Optional for manual assertions."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/eventCorefersWith",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/Event"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "event corefers with"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/fneo/Event"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Optionally relates two events that a reviewed judgement treats as the same event within one document."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "Two event individuals judged to corefer inside one synthetic document."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Optional identity module. A one-to-one canonicalisation link is not this property. Symmetry and transitivity are not declared."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/assertionSubject",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/RelationAssertion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assertion subject"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Relates a qualified assertion resource to the subject of the domain statement it qualifies."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The market-change event that is the subject of a qualified participation."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Not an OWL functional property. The core profile expects one subject on a qualified assertion. Ordinary triples without material statement metadata do not use this property."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/sourceDocumentIdentifier",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/FinancialNewsDocument"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source document identifier"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The identifier of the source document, stored as provenance on a financial news document."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "SYN-DOC-001 on a synthetic brief."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The literal supports traceability. It is not the identity of the ontology individual. The core profile requires one on a financial news document."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/Committed",
    "@type": [
      "https://w3id.org/fneo/CommitmentStatus",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "committed"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The commitment status for a temporal relation that is committed and, when also accepted, may materialise a direct temporal triple."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "Committed on an explicit before-relation."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Commitment alone is recorded on the qualified resource. The extension profile checks that a committed ordering relation has its direct triple."
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/license",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/fneo/QuantityValue",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "quantity value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/NumericalValue"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A numerical value that is a non-percentage quantity, such as a point change, distinct from a percentage and from a monetary amount."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A fabricated point quantity stored as document-level data."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Extension class under numerical value. Not a core evaluation target and not an event attachment by default."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/hasReportedValue",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/Event"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has reported value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/fneo/NumericalValue"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "An extension relation from a reported event to a numerical value, used only when a manually validated mapping exists."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A manually validated link from an event to a document-level quantity."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Not a core requirement. Sentence co-presence is not evidence for this property. Absence on a market-change event is information in the core profile."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/Event",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "event"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/fneo/Entity"
      },
      {
        "@id": "https://w3id.org/fneo/TimeEntity"
      },
      {
        "@id": "https://w3id.org/fneo/NumericalValue"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A reported event denoted by one or more textual expressions, distinct from those expressions, from entities, and from claims about the event."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A reported fall, distinct from the index that fell and from the wording that reports it."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "A financial-event category is not implied by this class. Event is disjoint with entity, time entity, and numerical value in this version."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/namespaceStatus",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "namespace status"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Records that the namespace and W3ID stem are provisional and not registered."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "Provisional and not registered."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "This annotation qualifies the namespace, not the domain semantics."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/NumericalValue",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "numerical value"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A numerical expression reported in a document, including its lexical form and, where parseable, a numeric value."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The lexical expression 2.5 percent in a fabricated sentence."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "In the core profile a numerical value stays a document-level expression. Direct attachment to an event is an extension relation and is not required."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/publicationTimeLiteral",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/TimeEntity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "publication time literal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Preserves the source lexical expression of a publication or creation time. The domain is TimeEntity."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "3 March 2026 beside a normalised timestamp."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Domain is TimeEntity only. This property is not a property of FinancialNewsDocument. It is distinct from normalisedTimeValue, which records the normalised form on the same time entity. The lexical expression is not a second publication-time relation."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/FinancialSituation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "financial situation"
      }
    ],
    "https://w3id.org/fneo/abstractExtensionPoint": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": true
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "An abstract extension point for a continuing economic situation, kept conceptually distinct from a dated reported event."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "No populated instance. Situation wording is not retyped as this class in version 0.1."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Not populated in this version, not a core validation target, and not given a subclass. A disjointness axiom with event is not asserted. Primary competency questions do not use this class."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/acronym",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "acronym"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The provisional acronym of the ontology."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "FNEO"
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "FNEO is provisional until the name is confirmed."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/temporalObject",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/TemporalRelationAssertion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "temporal object"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Relates a temporal relation assertion to the object of the temporal relation."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The later event in an accepted before-relation."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The range is left open for the same reason as temporal subject. Event-event and event-time readings are distinguished by the temporal relation type and by shapes."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/CommercialBank",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "commercial bank"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/FinancialOrganisation"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A commercial bank or bank group, classified in context."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A fictional commercial bank, distinct from a central bank in the same brief."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Extension class under financial organisation. Not declared disjoint with central bank. Ambiguous names are not forced into this class."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/materialisationEligibility",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/TemporalRelationAssertion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "materialisation eligibility"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Whether a qualified temporal assertion may materialise a positive direct RDF triple."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "accepted on an explicit precedes assertion, or not_accepted on a suppressed candidate."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Accepted eligibility still requires the assertion to be accepted, committed where applicable, not suppressed, canonically mapped, and traceable. Other values must not co-exist with a positive direct temporal triple."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/follows",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/Event"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "follows"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/fneo/Event"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Relates a reported event to another reported event that it follows under an accepted extension temporal relation."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The inverse reading of an accepted precedes link."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Inverse of precedes. Declaring the inverse does not accept inverse-generated candidates. Those remain qualified resources without a positive direct triple until they are accepted. A reasoner-entailed follows triple is not a separately accepted extraction."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/TemporalRelationAssertion",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "temporal relation assertion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/RelationAssertion"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A qualified assertion specialised for a temporal relation, preserving the temporal subject, relation type, temporal object, commitment, inference status, and audit labels."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "An explicit before-relation between two synthetic events, with a matching precedes triple."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "An accepted temporal assertion may also carry a direct temporal triple. A suppressed, rejected, proposed, or review-required temporal assertion must not carry a positive direct temporal triple."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/tokenStart",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb40"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "token start"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The inclusive start of a half-open token interval [tokenStart, tokenEnd)."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "Token index 6 for the word fell in a synthetic sentence."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Optional when a character span is stored, and sufficient evidence when a character span is absent. Token indexes are provenance coordinates, not ontology identity."
      }
    ]
  },
  {
    "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb40",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/fneo/TextualMention"
          },
          {
            "@id": "https://w3id.org/fneo/TextualEvidence"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/sourceAnnotationIdentifier",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source annotation identifier"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The identifier of a source annotation, stored as provenance."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "SYN-ANN-FALL on a synthetic event."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Not ontology identity. Identifiers are not assumed to be stable across annotation editions. For a market-change event, an annotation identifier can stand as source grounding beside an event mention."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/populatedByActivity",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "populated by activity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/prov#wasGeneratedBy"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Relates an ontology individual to the population activity that produced it."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A qualified assertion linked to a named population activity IRI."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Local property. See also prov:wasGeneratedBy. PROV-O is not imported. A software-agent class is not defined in this version."
      }
    ]
  },
  {
    "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb13",
    "@type": [
      "http://www.w3.org/2002/07/owl#AllDifferent"
    ],
    "http://www.w3.org/2002/07/owl#distinctMembers": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/fneo/Explicit"
          },
          {
            "@id": "https://w3id.org/fneo/RuleInferred"
          },
          {
            "@id": "https://w3id.org/fneo/InverseGenerated"
          },
          {
            "@id": "https://w3id.org/fneo/ClosureDerived"
          },
          {
            "@id": "https://w3id.org/fneo/ModelInferred"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/numericalValue",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/NumericalValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "numerical value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The parsed numeric value of a numerical expression when parsing succeeds."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "2.5 as a decimal for a lexical percentage 2.5%."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The datatype is xsd:decimal. For a percentage value the scale is percentage points: 2.5 means 2.5 percent, not 0.025. An unparseable expression may omit this literal."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/includes",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/TimeEntity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "includes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/fneo/Event"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Relates a time entity interval to a reported event that the interval includes, when an accepted extension relation supports that reading."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "An interval includes a reported market-change event."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Inverse of occurs during. The public name is includes. A raw operational label is not copied into the property name. A reasoner-entailed includes triple is not a separately accepted extraction."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/During",
    "@type": [
      "https://w3id.org/fneo/TemporalRelationType",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "during"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The temporal relation type that pairs with the object property occursDuring."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "During on an accepted occursDuring assertion."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The direct triple, when accepted, runs from an event to a time entity."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/SuppressedCommitment",
    "@type": [
      "https://w3id.org/fneo/CommitmentStatus",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "suppressed commitment"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The commitment status for a temporal candidate whose commitment is suppressed."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The commitment state of an inverse-generated candidate that is held back."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "A suppressed commitment must not materialise a positive direct temporal triple."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/canonicalPublicRelation",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/TemporalRelationAssertion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "canonical public relation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The approved public relation name to which a source temporal relation is mapped."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "precedes on an accepted before-relation."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Typical values are hasEventTime, precedes, follows, simultaneousWith, occursDuring, and includes. An unmapped label has no canonical public relation and is not materialised."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/hasMention",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb30"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has mention"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/fneo/TextualMention"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Relates a canonical entity, event, or time entity to a textual mention that denotes it."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A fictional index linked to the mention of its name."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The domain is the union of entity, event, and time entity. That union does not introduce a shared superclass. The inverse of denotes is not declared."
      }
    ]
  },
  {
    "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb30",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/fneo/Entity"
          },
          {
            "@id": "https://w3id.org/fneo/Event"
          },
          {
            "@id": "https://w3id.org/fneo/TimeEntity"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/occursDuring",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/Event"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "occurs during"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/fneo/TimeEntity"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://w3id.org/fneo/includes"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Relates a reported event to a time entity interval during which the event is reported to occur, when an accepted extension relation supports that reading."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "An event occurs during a stated afternoon interval."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Inverse of includes. The property does not invent an interval for an underspecified time. A reasoner may entail includes from an asserted occursDuring triple. That entailment is not independently extracted evidence."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/EventMention",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "event mention"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/TextualMention"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A textual expression that denotes a reported event."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The word fell used as the expression of a market-change event."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "An event mention is not the event it denotes. A one-to-one link from expression to event is canonicalisation, not event coreference."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/characterStart",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb46"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "character start"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The inclusive start of a half-open character interval [characterStart, characterEnd)."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The inclusive character index of a mention in a synthetic sentence."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Optional when token offsets exist. Do not invent character offsets that were not stored."
      }
    ]
  },
  {
    "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb46",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/fneo/TextualMention"
          },
          {
            "@id": "https://w3id.org/fneo/TextualEvidence"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/EquityShare",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "equity share"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/FinancialObject"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/fneo/FinancialOrganisation"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "An equity share, distinct from the organisation that issues that share."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A fictional ordinary share distinguished from its issuing organisation."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Extension class under financial object. Disjoint with financial organisation in this version. An issuing relation is not defined in this version."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/FinancialEvent",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "financial event"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/Event"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A reported event that the ontology types as financial."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A reported change in a named index."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Subclass of event. The only approved financial-event subclass in this version is market-change event."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/Proposed",
    "@type": [
      "https://w3id.org/fneo/CommitmentStatus",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "proposed"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The commitment status for a temporal candidate that has been proposed and must not materialise a positive direct temporal triple."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A proposed ordering candidate without a direct temporal triple."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Proposed is an experimental or review state, not an accepted fact."
      }
    ]
  },
  {
    "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb1",
    "@type": [
      "http://www.w3.org/2002/07/owl#AllDifferent"
    ],
    "http://www.w3.org/2002/07/owl#distinctMembers": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/fneo/UpwardDirection"
          },
          {
            "@id": "https://w3id.org/fneo/DownwardDirection"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/sourceKind",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/TemporalRelationAssertion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source kind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The kind of temporal source, such as explicit annotation, population derivation, inverse generation, rule inference, closure, or learned prediction."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "explicit on an accepted temporal assertion."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Source kind selects the temporal profile. It does not by itself accept a relation."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/supportedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb37"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "supported by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/fneo/TextualEvidence"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Relates a reported event or a qualified assertion to the textual evidence that supports it."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A market-change event supported by a fabricated sentence."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The domain is the union of event and relation assertion. The range is textual evidence. A typed market-change event requires at least one supporting evidence individual under the core profile."
      }
    ]
  },
  {
    "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb37",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/fneo/Event"
          },
          {
            "@id": "https://w3id.org/fneo/RelationAssertion"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/TimeMention",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "time mention"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/TextualMention"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A textual mention of a time expression, distinct from the time entity that the mention denotes."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The word Tuesday as a mention of a normalised day."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "A time mention is not a time entity, an entity mention, or an event mention. Character offsets are optional when token offsets exist."
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/issued",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/fneo/hasPercentageChange",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/MarketChangeEvent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has percentage change"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/fneo/PercentageValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/fneo/hasReportedValue"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "An extension relation from a market-change event to a percentage value under a manually validated mapping."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A reviewed link from a market-change event to a 2.5 percentage-point value."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Subproperty of has reported value. Not required by the core profile. A document-level percentage does not by itself create this link."
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/creator",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb4",
    "@type": [
      "http://www.w3.org/2002/07/owl#AllDifferent"
    ],
    "http://www.w3.org/2002/07/owl#distinctMembers": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/fneo/Accepted"
          },
          {
            "@id": "https://w3id.org/fneo/RequiresReview"
          },
          {
            "@id": "https://w3id.org/fneo/Rejected"
          },
          {
            "@id": "https://w3id.org/fneo/Suppressed"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/preferredNamespacePrefix",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "preferred namespace prefix"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The preferred prefix for the term namespace."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "fneo"
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The prefix fneo expands to the term base, not to the ontology IRI."
      }
    ]
  },
  {
    "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb9",
    "@type": [
      "http://www.w3.org/2002/07/owl#AllDifferent"
    ],
    "http://www.w3.org/2002/07/owl#distinctMembers": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/fneo/Committed"
          },
          {
            "@id": "https://w3id.org/fneo/Proposed"
          },
          {
            "@id": "https://w3id.org/fneo/SuppressedCommitment"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/relationSource",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/TemporalRelationAssertion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "relation source"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The source or derivation activity from which a temporal relation was taken."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "synthetic-explicit on a hand-authored temporal assertion."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Lightweight provenance string. A later alignment may map it toward PROV-O. No import is required."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/EntityMention",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "entity mention"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/TextualMention"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A textual mention that denotes an entity."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A mention of a fictional market index."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "An entity mention is not the entity it denotes. In the core profile an in-profile entity mention denotes one entity."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/Before",
    "@type": [
      "https://w3id.org/fneo/TemporalRelationType",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "before"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The temporal relation type that pairs with the object property precedes."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "Before on an accepted assertion whose direct triple uses precedes."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Use this individual on temporalRelationType. Do not use it as a property name."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/preferredNamespaceUri",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "preferred namespace URI"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The IRI stem to which the preferred prefix expands."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "https://w3id.org/fneo/"
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Term IRIs are formed by appending a local name to this stem."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/PercentageValue",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "percentage value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/NumericalValue"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A numerical value whose reported form is a percentage."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "Lexical form 2.5% with numerical value 2.5."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The lexical form keeps the percent sign or the word percent. numericalValue is an xsd:decimal in percentage points: 2.5 means 2.5 percent, not the fraction 0.025. Percentage-occurrence querying is extension evaluation. Document co-presence with an index is not an attachment."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/numericalLexicalForm",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/NumericalValue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "numerical lexical form"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The lexical form of a numerical expression as it appears in the text."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "2.5% on a percentage value whose numeric value is 2.5."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "For a percentage, this form preserves the percent sign or the word percent. It is the property used for percentage surface form. textualForm remains the mention string."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/MarketDirection",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "market direction"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The controlled-value class for an optional direction of a market-change event."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A downward direction on one market-change event and no direction on another."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The version 0.1 individuals are upward and downward. The class is not closed with owl:oneOf. Direction is not mandatory. There is no mixed-direction individual."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/Suppressed",
    "@type": [
      "https://w3id.org/fneo/ValidationStatus",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "suppressed"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The validation status for an assertion that is suppressed and must not materialise a positive direct semantic triple."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A suppressed simultaneous candidate with no simultaneousWith triple."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Suppression is auditable through the qualified resource and, where relevant, suppressionReason."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/TimeEntity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "time entity"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A canonical time with a lexical form and, where recorded, a normalised value."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The publication timestamp of a news document, or a weekday anchored to an event."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Publication time and event time are different relations to time entities. Time entity is not a subclass of entity. The normalised value is a string because stored forms mix dates, timestamps, durations, and underspecified values."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/ModelInferred",
    "@type": [
      "https://w3id.org/fneo/InferenceStatus",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "model inferred"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The inference status for a relation produced by a learned temporal model."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A model score retained on a candidate that has no direct triple."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Learned relations are experimental and are not accepted direct facts in this version."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/mentionedIn",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/TextualMention"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "mentioned in"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/fneo/FinancialNewsDocument"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Relates a textual mention to the financial news document in which it occurs."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "An index mention occurs in a synthetic brief."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Not functional. Many mentions share one document. Numerical values are reached from a document through a mention that denotes the value, because this property's domain is textual mention."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/Accepted",
    "@type": [
      "https://w3id.org/fneo/ValidationStatus",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "accepted"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The validation status for an assertion that is accepted and may materialise a direct semantic triple together with its qualified resource."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "An accepted participation that also has a hasAffectedMarket triple."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Accepted materialisation still requires the qualified resource when statement metadata is material."
      }
    ]
  },
  {
    "@id": "_:nc7d7651d12f2401282192aa5ebdcd58bb19",
    "@type": [
      "http://www.w3.org/2002/07/owl#AllDifferent"
    ],
    "http://www.w3.org/2002/07/owl#distinctMembers": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/fneo/NotReviewed"
          },
          {
            "@id": "https://w3id.org/fneo/ReviewRequired"
          },
          {
            "@id": "https://w3id.org/fneo/ManuallyAccepted"
          },
          {
            "@id": "https://w3id.org/fneo/ManuallyRejected"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/FinancialMeasurement",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "financial measurement"
      }
    ],
    "https://w3id.org/fneo/abstractExtensionPoint": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": true
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "An abstract extension point for a measurement, such as a level or a price reading, kept distinct from the event that reports a change and from the numerical expression used to write the measurement."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "No core instance. A quantity written beside an index name remains a numerical value."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Not a populated class in this version, not a parent of numerical value, and not a core validation target. No populated subclass is defined."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/hasParticipant",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/Event"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has participant"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/fneo/Entity"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "Relates a reported event to an entity that participated in it, without naming a financial role."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A market-change event has the affected index as a participant through the subproperty hasAffectedMarket."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Domain event and range entity. No OWL property characteristics are declared. Source role labels are not values of this property."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/UpwardDirection",
    "@type": [
      "https://w3id.org/fneo/MarketDirection",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "upward direction"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The controlled value for an upward market direction."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "An upward reading on a rise in a fictional equity market."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Optional. Not a subclass of market-change event. When used, validation status and population method are expected by the core profile."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/ManualReviewStatus",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "manual review status"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The controlled-value class for whether an assertion or extension individual has been routed to, or has completed, manual review."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "Manually accepted on a fictional central bank."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Distinct from validation status so that routing and outcome can differ. A parallel literal is not defined. Missing review on an extension bank, system, or sector is a warning, not a violation."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/FinancialSystem",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "financial system"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/FinancialEntity"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "An expression referring to a financial system, kept distinguishable from a financial sector, a market index, a bank, and crisis or recession wording."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The wording of a fictional financial system after manual review."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Extension class under financial entity. Not declared disjoint with financial sector. Ambiguous expressions stay review-required and are not a validation violation."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/TextualMention",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "textual mention"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/fneo/Entity"
      },
      {
        "@id": "https://w3id.org/fneo/Event"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A textual occurrence of an entity, event, time, or value, distinct from the canonical object that the occurrence denotes."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The surface string of a fictional index name."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Entity mentions, event mentions, and time mentions specialise this class. A value expression may remain a textual mention when no narrower mention class is approved."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/originalTemporalRelationLabel",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/TemporalRelationAssertion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "original temporal relation label"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The original operational or annotation relation label, retained for audit and not used as a public property name."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "BEFORE on an assertion whose public property is precedes."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The literal retains the original operational relation label. Values such as BEFORE stay in this literal and are not used as public property names."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/FinancialObject",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "financial object"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/FinancialEntity"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A financial entity that is an object such as a market index, an equity share, or a currency, rather than an organisation or a market venue."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A named index, a share, or a named currency."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Abstract modelling class. Market index, equity share, and currency specialise it. It is not a gold population target by itself, and a market index is not a financial market."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/ManuallyRejected",
    "@type": [
      "https://w3id.org/fneo/ManualReviewStatus",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "manually rejected"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The review status for an individual or assertion that a reviewer has rejected."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A reviewer-rejected ambiguous organisation name."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Manual rejection does not by itself delete the resource. It does not authorise a positive direct triple."
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/description",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/fneo/RequiresReview",
    "@type": [
      "https://w3id.org/fneo/ValidationStatus",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "requires review"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The validation status for a candidate assertion that is retained for review and must not materialise a positive direct semantic triple."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A participation candidate with no matching direct triple."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "The candidate resource remains in the graph. Competency-question answers should not treat it as an accepted fact."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/ruleIdentifier",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "rule identifier"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The identifier of the enrichment rule or manual protocol that produced an assertion."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "SYN-PART-001 on a synthetic participation."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Provenance string, not a public class name. When populatedByRule is also present the two strings should not diverge."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/MarketIndex",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "market index"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/fneo/FinancialObject"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/fneo/EquityMarket"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A named market index mentioned as an index, kept distinct from a collective equity market, a currency, a bank, and a price."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A fictional index such as the Northwind Market Index."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Subclass of financial object. Not a subclass of financial market. Disjoint with equity market and with financial organisation in this version."
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/title",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/fneo/assertionPredicateIRI",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/RelationAssertion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assertion predicate IRI"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The IRI of the predicate of the domain statement that a qualified assertion describes, stored as a literal so the ontology does not pun a property as an individual."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "The IRI of hasAffectedMarket stored as an anyURI literal."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Range xsd:anyURI. The literal stores the predicate IRI so the ontology does not pun a property as an individual. Properties remain properties. RDF reification is a candidate alignment, not the model."
      }
    ]
  }
]