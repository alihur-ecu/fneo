    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "owl:priorVersion is used when a prior ontology IRI exists. This candidate points at development candidate 0.1.0-rc1. No stable public release precedes 0.1.0."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/hasInferenceStatus",
