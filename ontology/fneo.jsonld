    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "simultaneous"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The temporal relation type that pairs with the object property simultaneousWith."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "Simultaneous on a suppressed candidate that has no simultaneousWith triple."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Symmetry is not declared on simultaneousWith in release candidate 0.1.0-rc2. Symmetry is pending verification of the operational source-relation semantics. The individual is still the controlled type for that reading. The temporal extension is experimental."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/evidenceText",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/fneo/TextualEvidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/fneo/ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "evidence text"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The text of a supporting passage when the evidence is wider than a single mention string."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "A fabricated sentence that supports a market-change event."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Distinct from textual form. A reconstructed passage is still evidence text. It is not claimed to be a gold sentence element."
      }
    ]
  },
  {
    "@id": "https://w3id.org/fneo/participatingEntity",
