        "@id": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "The exclusive end of a half-open token interval [tokenStart, tokenEnd)."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "Token index 7 as the exclusive end of a one-token span."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "When both token offsets are present for a non-empty span, tokenEnd is greater than tokenStart."
      }
    ]
  },
