      }
    ],
    "https://w3id.org/fneo/definition": [
      {
        "@language": "en",
        "@value": "A short explanation of why a temporal or other qualified assertion was suppressed."
      }
    ],
    "https://w3id.org/fneo/example": [
      {
        "@language": "en",
        "@value": "An inverse-generated candidate retained for audit and not accepted."
      }
    ],
    "https://w3id.org/fneo/scopeNote": [
      {
        "@language": "en",
        "@value": "Used with validation status Suppressed or commitment status SuppressedCommitment. Suppression does not materialise a positive direct triple."
      }
