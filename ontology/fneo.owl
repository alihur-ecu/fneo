    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="nc7d7651d12f2401282192aa5ebdcd58bb44"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc7d7651d12f2401282192aa5ebdcd58bb23">
    <rdf:first rdf:resource="https://w3id.org/fneo/ManuallyRejected"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc7d7651d12f2401282192aa5ebdcd58bb9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
    <owl:distinctMembers rdf:nodeID="nc7d7651d12f2401282192aa5ebdcd58bb10"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc7d7651d12f2401282192aa5ebdcd58bb36">
    <rdf:first rdf:resource="https://w3id.org/fneo/MarketIndex"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fneo/RuleInferred">
    <rdf:type rdf:resource="https://w3id.org/fneo/InferenceStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">rule inferred</rdfs:label>
    <fneo:definition xml:lang="en">The inference status for a relation produced by a rule rather than stated explicitly.</fneo:definition>
    <fneo:scopeNote xml:lang="en">Rule-inferred temporal candidates stay in the experimental profile unless a separate acceptance decision materialises them.</fneo:scopeNote>
    <fneo:example xml:lang="en">A rule-inferred ordering retained only as a candidate.</fneo:example>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/fneo/ontology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/fneo/InferenceStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inference status</rdfs:label>
    <fneo:definition xml:lang="en">The controlled-value class for how a temporal or other qualified relation was obtained.</fneo:definition>
    <fneo:scopeNote xml:lang="en">Explicit, rule-inferred, inverse-generated, closure-derived, and model-inferred are the version 0.1 individuals. Experimental statuses are not treated as explicit evidence. A parallel literal is not defined.</fneo:scopeNote>
    <fneo:example xml:lang="en">Explicit on an accepted temporal assertion, and inverse-generated on a suppressed candidate.</fneo:example>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/fneo/ontology"/>
  </rdf:Description>
