_:n22e5e3186a564b568640cbdc1a93a05db38 a sh:SPARQLConstraint ;
    sh:message "Event time is not mandatory for every market-change event. Absence of an explicit event time is a warning." ;
    sh:select """
            SELECT $this WHERE {
              FILTER NOT EXISTS { $this fneo:hasEventTime ?time }
            }
        """ ;
    sh:severity sh:Warning .

_:n22e5e3186a564b568640cbdc1a93a05db39 a sh:SPARQLConstraint ;
    sh:message "Absence of a normalised time value on a market-change event is a warning." ;
    sh:select """
            SELECT $this WHERE {
              FILTER NOT EXISTS {
                $this fneo:hasEventTime ?time .
                ?time fneo:normalisedTimeValue ?value .
              }
            }
        """ ;
    sh:severity sh:Warning .

_:n22e5e3186a564b568640cbdc1a93a05db43 a sh:SPARQLConstraint ;
    sh:message "Market direction is optional. Absence is Info and is not a mandatory failure." ;
    sh:select """
            SELECT $this WHERE {
              FILTER NOT EXISTS { $this fneo:hasMarketDirection ?direction }
            }
        """ ;
    sh:severity sh:Info .

_:n22e5e3186a564b568640cbdc1a93a05db44 a sh:SPARQLConstraint ;
    sh:message "A percentage value on a market-change event is optional. Absence is Info." ;
    sh:select """
            SELECT $this WHERE {
              FILTER NOT EXISTS { $this fneo:hasPercentageChange ?value }
            }
        """ ;
    sh:severity sh:Info .

_:n22e5e3186a564b568640cbdc1a93a05db45 a sh:SPARQLConstraint ;
    sh:message "A numerical value on a market-change event is optional. Absence is Info." ;
    sh:select """
            SELECT $this WHERE {
              FILTER NOT EXISTS { $this fneo:hasReportedValue ?value }
            }
        """ ;
    sh:severity sh:Info .

_:n22e5e3186a564b568640cbdc1a93a05db46 a sh:SPARQLConstraint ;
    sh:message "Event-value attachment is not mandatory. Absence is Info." ;
    sh:select """
            SELECT $this WHERE {
              FILTER NOT EXISTS { $this fneo:hasReportedValue ?reported }
              FILTER NOT EXISTS { $this fneo:hasPercentageChange ?percentage }
              FILTER NOT EXISTS { $this fneo:hasMonetaryAmount ?amount }
            }
        """ ;
    sh:severity sh:Info .

_:n22e5e3186a564b568640cbdc1a93a05db20 a sh:SPARQLConstraint ;
    sh:message "Textual evidence should be traceable to a financial news document." ;
    sh:select """
            SELECT $this WHERE {
              FILTER NOT EXISTS {
                ?event fneo:supportedBy $this .
                ?document fneo:reportsEvent ?event .
              }
            }
        """ ;
    sh:severity sh:Warning .

