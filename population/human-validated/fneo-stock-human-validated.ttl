<https://w3id.org/fneo/resource/evidence/meantime-en-stock/114719/evidence-b6ec1fad562ae2ab> fneo:characterEnd "537"^^xsd:nonNegativeInteger ;
    fneo:characterStart "531"^^xsd:nonNegativeInteger ;
    fneo:evidenceText "The U.S. markets opened on the positive side, but with bad news coming from several different areas such as uncertainty over whether the 700 billion USD bank bailout bill passed by the United States House of Representatives and the Senate will be effective."^^xsd:string ;
    fneo:tokenEnd "111"^^xsd:nonNegativeInteger ;
    fneo:tokenStart "110"^^xsd:nonNegativeInteger ;
    a fneo:TextualEvidence .

<https://w3id.org/fneo/resource/evidence/meantime-en-stock/114719/evidence-c2eadcc832772db5> fneo:characterEnd "964"^^xsd:nonNegativeInteger ;
    fneo:characterStart "960"^^xsd:nonNegativeInteger ;
    fneo:evidenceText "One of the biggest stocks to drop was General Motors, which lost more than 33% of its value."^^xsd:string ;
    fneo:tokenEnd "187"^^xsd:nonNegativeInteger ;
    fneo:tokenStart "186"^^xsd:nonNegativeInteger ;
    a fneo:TextualEvidence .

<https://w3id.org/fneo/resource/evidence/meantime-en-stock/114719/evidence-d490bc5390300d84> fneo:characterEnd "175"^^xsd:nonNegativeInteger ;
    fneo:characterStart "152"^^xsd:nonNegativeInteger ;
    fneo:evidenceText "Stock markets across the world fell dramatically this week on worries that recent government moves might not prevent a global recession."^^xsd:string ;
    fneo:tokenEnd "32"^^xsd:nonNegativeInteger ;
    fneo:tokenStart "31"^^xsd:nonNegativeInteger ;
    a fneo:TextualEvidence .

