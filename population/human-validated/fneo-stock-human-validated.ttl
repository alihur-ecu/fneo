    fneo:evidenceText "Investors are awaiting the outcome of several meetings that will be held this weekend."^^xsd:string ;
    fneo:tokenEnd "317"^^xsd:nonNegativeInteger ;
    fneo:tokenStart "316"^^xsd:nonNegativeInteger ;
    a fneo:TextualEvidence .

